# N-Genius — set NGENIUS_ENV=production only with production keys/outlet/webhook
NGENIUS_ENV=sandbox
NGENIUS_API_KEY=
NGENIUS_OUTLET_REF=
# Required (≥16 chars). Configure same value as N-Genius portal Header Value.
NGENIUS_WEBHOOK_SECRET=
# Sandbox host (ignored when NGENIUS_ENV=production)
NGENIUS_SANDBOX_BASE_URL=https://api-gateway.sandbox.ngenius-payments.com
# Production host (used when NGENIUS_ENV=production)
NGENIUS_PRODUCTION_BASE_URL=https://api-gateway.ksa.ngenius-payments.com
# Realm from the provider portal — keep exactly as issued (e.g. NIARABIA)
NGENIUS_REALM=NIARABIA
# Portal Header Key must match (N-Genius supports custom headers).
NGENIUS_WEBHOOK_HEADER=x-toury-webhook-token
# Temporary only: allow POST /health/ngenius/hpp-probe (create order, no card capture)
ALLOW_HPP_PROBE=false

# Firebase Admin — preferred on Render: base64 of EXISTING project service-account JSON
# (same Firebase project; do not create a new project / invent keys)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Or set the three fields below instead of base64 (not needed on Cloud Functions ADC):
FIREBASE_PROJECT_ID=tutorial-multi-language-70gx4j
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# On Firebase Functions, ADC is auto-detected (FIREBASE_CONFIG / FUNCTION_TARGET / K_SERVICE).
# Set explicitly for local ADC testing if needed:
# FIREBASE_USE_APPLICATION_DEFAULT=true

# 3DS hosted-page return/cancel (defaults to Firebase Hosting payment-return.html)
ALLOWED_APP_ORIGINS=
PAYMENT_RETURN_BASE_URL=https://tutorial-multi-language-70gx4j.web.app/payment-return.html
PAYMENT_CANCEL_BASE_URL=https://tutorial-multi-language-70gx4j.web.app/payment-return.html
PAYMENT_API_PUBLIC_BASE_URL=

# Optional
SERVICE_VERSION=0.2.0
PORT=3010
