# N-Genius — default sandbox. Production requires NGENIUS_ENV=production
NGENIUS_ENV=sandbox
NGENIUS_API_KEY=
NGENIUS_OUTLET_REF=
NGENIUS_WEBHOOK_SECRET=
NGENIUS_SANDBOX_BASE_URL=https://api-gateway.sandbox.ngenius-payments.com
NGENIUS_PRODUCTION_BASE_URL=https://api-gateway.ngenius-payments.com
NGENIUS_REALM=
NGENIUS_WEBHOOK_HEADER=x-toury-webhook-token

# Firebase Admin (paste private key with \n escapes; never commit real values)
FIREBASE_PROJECT_ID=tutorial-multi-language-70gx4j
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# App / redirects
ALLOWED_APP_ORIGINS=
PAYMENT_RETURN_BASE_URL=
PAYMENT_CANCEL_BASE_URL=
PAYMENT_API_PUBLIC_BASE_URL=

# Optional
SERVICE_VERSION=0.1.0
