# N-Genius — sandbox only until explicitly approved for production
NGENIUS_ENV=sandbox
NGENIUS_API_KEY=
NGENIUS_OUTLET_REF=
# Required (≥16 chars). Configure same value as N-Genius portal Header Value.
NGENIUS_WEBHOOK_SECRET=
# Arabia portal merchants (realm NIARABIA): use KSA sandbox host.
# If unset and NGENIUS_REALM=NIARABIA, the service defaults to this host.
NGENIUS_SANDBOX_BASE_URL=https://api-gateway.sandbox.ksa.ngenius-payments.com
# Production host (do not set NGENIUS_ENV=production without approval)
NGENIUS_PRODUCTION_BASE_URL=https://api-gateway.ksa.ngenius-payments.com
# Realm from portal — keep NIARABIA when that is what the provider issued.
# Generic sandbox docs use `ni`; production often `networkinternational`.
NGENIUS_REALM=NIARABIA
# Portal Header Key must match (N-Genius supports custom headers).
NGENIUS_WEBHOOK_HEADER=x-toury-webhook-token

# Firebase Admin — preferred: base64 of EXISTING project service-account JSON
# (same Firebase project; do not create a new project / invent keys)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Or set the three fields below instead of base64:
FIREBASE_PROJECT_ID=tutorial-multi-language-70gx4j
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 3DS hosted-page return/cancel (defaults to Firebase Hosting payment-return.html)
ALLOWED_APP_ORIGINS=
PAYMENT_RETURN_BASE_URL=https://tutorial-multi-language-70gx4j.web.app/payment-return.html
PAYMENT_CANCEL_BASE_URL=https://tutorial-multi-language-70gx4j.web.app/payment-return.html
PAYMENT_API_PUBLIC_BASE_URL=

# Optional
SERVICE_VERSION=0.2.0
PORT=3010
