    "description": "UI string (source key: ui_text_af02762d6d)"
  },
  "ui_text_9072549574": "макул",
  "@ui_text_9072549574": {
    "description": "UI string (source key: ui_text_9072549574)"
  },
  "ui_text_17db754851": "Кошулган: Жайгашкан жер ийгиликтүү тандалды",
  "@ui_text_17db754851": {
    "description": "UI string (source key: ui_text_17db754851)"
  },
  "ui_text_71995f6f4a": "Жайгашкан жер мурунтан эле кошулган.",
  "@ui_text_71995f6f4a": {
    "description": "UI string (source key: ui_text_71995f6f4a)"
  },
  "ui_text_b73e88df71": "Билдирүү жаз",
  "@ui_text_b73e88df71": {
    "description": "UI string (source key: ui_text_b73e88df71)"
  },
  "ui_text_b4bbf18b10": "Буйрутманы жокко чыгаруу",
  "@ui_text_b4bbf18b10": {
    "description": "UI string (source key: ui_text_b4bbf18b10)"
  },
  "ui_text_cf4d76accb": "Заказды жокко чыгарасызбы?",
  "@ui_text_cf4d76accb": {
    "description": "UI string (source key: ui_text_cf4d76accb)"
  },
  "ui_text_5c528d9fa3": "жок",
  "@ui_text_5c528d9fa3": {
    "description": "UI string (source key: ui_text_5c528d9fa3)"
  },
  "ui_text_d045bef8e5": "Ооба",
  "@ui_text_d045bef8e5": {
    "description": "UI string (source key: ui_text_d045bef8e5)"
  },
  "ui_text_1431f68f35": "Жөндөлбөйт",
  "@ui_text_1431f68f35": {
    "description": "UI string (source key: ui_text_1431f68f35)"
  },
  "ui_text_8bc9b333df": "Булакты тандаңыз",
  "@ui_text_8bc9b333df": {
    "description": "UI string (source key: ui_text_8bc9b333df)"
  },
  "ui_text_35d76b889c": "Электрондук почта керек!",
  "@ui_text_35d76b889c": {
    "description": "UI string (source key: ui_text_35d76b889c)"
  },
  "ui_text_f0ad7ac205": "Рахмат",
  "@ui_text_f0ad7ac205": {
    "description": "UI string (source key: ui_text_f0ad7ac205)"
  },
  "ui_text_12ee72ca4f": "Сапардын корутундусу",
  "@ui_text_12ee72ca4f": {
    "description": "UI string (source key: ui_text_12ee72ca4f)"
  },
  "ui_text_d93bf2eb9f": "Аралык жана убакыт болжолдуу жана трафикке, маршруттун өзгөрүшүнө же жайгашкан жердин тактыгына жараша өзгөрүшү мүмкүн.",
  "@ui_text_d93bf2eb9f": {
    "description": "UI string (source key: ui_text_d93bf2eb9f)"
  },
  "ui_text_e93e07976e": "Рейтинг жөнөтүлдү",
  "@ui_text_e93e07976e": {
    "description": "UI string (source key: ui_text_e93e07976e)"
  },
  "ui_text_7f2f6a15cf": "Ката",
  "@ui_text_7f2f6a15cf": {
    "description": "UI string (source key: ui_text_7f2f6a15cf)"
  },
  "ui_text_9262ef60ec": "Дата менен убакытты текшериңиз",
  "@ui_text_9262ef60ec": {
    "description": "UI string (source key: ui_text_9262ef60ec)"
  },
  "ui_text_cff8cb30ef": "Буйрутманы жокко чыгарып, төлөмдү кайтарып ала турганыңыз чынбы?",
  "@ui_text_cff8cb30ef": {
    "description": "UI string (source key: ui_text_cff8cb30ef)"
  },
  "ui_text_23ef9d7d03": "Ооба, буйрутманы жокко чыгарыңыз",
  "@ui_text_23ef9d7d03": {
    "description": "UI string (source key: ui_text_23ef9d7d03)"
  },
  "ui_text_eae6165343": "Буйрутма ийгиликтүү жокко чыгарылды",
  "@ui_text_eae6165343": {
    "description": "UI string (source key: ui_text_eae6165343)"
  },
  "ui_text_860c735760": "Буйрутманы жокко чыгара албайсыз, анткени жокко чыгаруу убактысы ашып кетти. Сураныч, колдоо тобуна кайрылыңыз",
  "@ui_text_860c735760": {
    "description": "UI string (source key: ui_text_860c735760)"
  },
  "ui_text_5a9a57155e": "Көчүрүлгөн",
  "@ui_text_5a9a57155e": {
    "description": "UI string (source key: ui_text_5a9a57155e)"
  },
  "ui_text_5eac766a7c": "Учурдагы жайгашкан жериңиз бир шаарда экенин текшериңиз жана бардык маалыматтарды так толтуруңуз.",
  "@ui_text_5eac766a7c": {
    "description": "UI string (source key: ui_text_5eac766a7c)"
  },
  "ui_text_1d36255e4a": "Сураныч, бардык маалыматтарды туура толтуруңуз",
  "@ui_text_1d36255e4a": {
    "description": "UI string (source key: ui_text_1d36255e4a)"
  },
  "ui_text_def4060285": "Даректи чын эле жок кылгыңыз келеби?",
  "@ui_text_def4060285": {
    "description": "UI string (source key: ui_text_def4060285)"
  },
  "ui_text_85d0e17cdb": "Дарек ийгиликтүү жок кылынды",
  "@ui_text_85d0e17cdb": {
    "description": "UI string (source key: ui_text_85d0e17cdb)"
  },
  "ui_text_471f24ef6b": "Жөнөтүлдү",
  "@ui_text_471f24ef6b": {
    "description": "UI string (source key: ui_text_471f24ef6b)"
  },
  "ui_text_dbee2e6613": "Сурам ийгиликтүү жөнөтүлдү, биз аны карап чыгып, бир аздан кийин сиз менен байланышабыз.",
  "@ui_text_dbee2e6613": {
    "description": "UI string (source key: ui_text_dbee2e6613)"
  },
  "ui_text_095479cd38": "Урматтуу өнөктөш, өтүнмөнү ийгиликтүү тапшыруу үчүн бардык талап кылынган талааларды толтуруңуз.",
  "@ui_text_095479cd38": {
    "description": "UI string (source key: ui_text_095479cd38)"
  },
