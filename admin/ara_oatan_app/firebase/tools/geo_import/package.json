{
  "name": "touri-geo-import",
  "version": "0.1.0",
  "private": true,
  "description": "Touri Taxi geographic data import toolkit (dry-run default; no production writes).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "geo:audit": "node src/cli.js audit",
    "geo:collect": "node src/cli.js collect",
    "geo:validate": "node src/cli.js validate",
    "geo:dedupe": "node src/cli.js dedupe",
    "geo:dry-run": "node src/cli.js dry-run",
    "geo:coverage": "node src/cli.js coverage",
    "geo:vehicles": "node src/cli.js vehicles",
    "geo:report": "node src/cli.js report",
    "geo:import:international-seven": "node import_international_seven.js",
    "geo:import:international-seven:production": "node import_international_seven.js --production --i-approve-production",
    "geo:import:emulator": "node src/cli.js import --target=emulator --country=ALL",
    "geo:staging:verify": "node src/cli.js staging-verify",
    "geo:rebuild:sa-kg": "node rebuild_sa_kg_catalog.js",
    "geo:rebuild:sa-kg:apply": "node rebuild_sa_kg_catalog.js --apply --hard-delete",
    "geo:rebuild:sa-five": "node rebuild_sa_five_provinces.js",
    "geo:rebuild:sa-five:apply": "node rebuild_sa_five_provinces.js --apply --hard-delete",
    "geo:phase": "node src/cli.js phase",
    "geo:phase1": "node src/cli.js phase --phase=1 --target=production --i-approve-production",
    "geo:phase2": "node src/cli.js phase --phase=2 --target=production --i-approve-production",
    "geo:phase3": "node src/cli.js phase --phase=3 --target=production --i-approve-production",
    "geo:phase4": "node src/cli.js phase --phase=4",
    "geo:images": "node src/cli.js images",
    "geo:images:meta": "node scripts/fetch_commons_meta.js",
    "test": "node --test tests/*.test.js"
  }
}
